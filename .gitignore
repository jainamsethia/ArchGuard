audit-results.json
pytest_output.txt
*_cov.txt
*_output.txt
coverage_*.txt
cov_*.txt
gate*.txt
temp_*.txt
err.txt
out.txt
/out.json
out_*.txt
out[0-9]*.txt
test_out.txt
test_report.html
analysis.json
fitness.json
scratch/
node_modules/
test-results/

# Local agent/tool state and working notes (never part of a release)
.claude/
ARCHGUARD_AUDIT_FIX_PROMPT.md
archguard_website_framework_v7_combined.md

# Vendored agent skills (re-fetchable from source, see skills-lock.json)
.agents/
skills-lock.json

# Playwright visual baselines are per-platform, and CI renders on Linux, so the
# -linux.png files are the ones that mean anything. A local run on another OS
# writes its own set beside them; committing those would mean every developer
# diffing against whichever machine happened to record first.
tests/visual/snapshots/**/*-win32.png
tests/visual/snapshots/**/*-darwin.png
