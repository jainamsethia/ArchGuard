.archguard-cache.json
.archguard-pending-contracts/

# Build artifacts
build/
dist/
*.egg-info/
*.bak

# IDE/editor
.vscode/
.idea/

# Environment files and credentials — NEVER commit secrets
.env
.env.local
.env.*.local
cookies.txt

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local scratch repos used for manual testing (root-level only; tests/fixtures/ stays tracked)
/test_repo/
/test_repo*/
/test_repo_1commit/
/test_repo_1commit_clean/
/empty_repo*/
/fixture_repo/
/test_dup/

