# ────────────────────────────────────────────────────────────────
# ArchGuard Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────

# ── LLM / AI  ────────────────────────────────────────────────────

# GEMINI_API_KEY — Optional (but recommended)
# Used by: archguard/llm/advisor.py (AI Advisor) and
#   archguard/llm/remediation.py (AI fix suggestions).
# Without this: every AI feature is disabled; analysis itself still runs.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=...your-key-here...

# GEMINI_MODEL — Optional, default: gemini-3.6-flash
# Model for one-shot calls (fix suggestions, advisor recommendations).
# GEMINI_MODEL=gemini-3.6-flash

# GEMINI_BASE_URL — Optional
# Default: https://generativelanguage.googleapis.com/v1beta/openai
# ArchGuard talks to Gemini over its OpenAI-compatible endpoint; override this
# only for a proxy or a different API version.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ARCHGUARD_PRIMARY_MODEL — Optional, default: gemini-3.6-flash
# Primary model for L4 explanations and contract inference.
# ARCHGUARD_PRIMARY_MODEL=gemini-3.6-flash

# ARCHGUARD_FALLBACK_MODEL — Optional, default: gemini-3.5-flash-lite
# Cheaper, faster model used when the primary is rate-limited, returns a server
# error, or times out. Keeping a second tier means a busy primary degrades the
# explanation rather than failing the run.
# ARCHGUARD_FALLBACK_MODEL=gemini-3.5-flash-lite

# OPENAI_API_KEY — DEPRECATED alias for GEMINI_API_KEY.
# Read only when GEMINI_API_KEY is unset, so existing deployments keep working;
# it must still contain a *Gemini* key. Warns when used. Prefer GEMINI_API_KEY.
# OPENAI_API_KEY=

# ── GitHub Integration  ──────────────────────────────────────────

# GITHUB_TOKEN — Optional but STRONGLY recommended
# Used by: archguard/dashboard/routes/jobs.py when reading repository metadata.
# Without this: GitHub API limited to 60 requests/hour (unauthenticated).
#   With a personal access token (classic): 5000 requests/hour.
#   Minimum required scope: public_repo (for public repositories)
GITHUB_TOKEN=ghp_...your-token-here...

# --- Authentication ---
# REQUIRED for any deployment reachable from outside localhost.
# Generate a strong random token: python -c "import secrets; print(secrets.token_hex(32))"
ARCHGUARD_DASHBOARD_TOKEN=

# DANGER: Set to 1 only if you have no token AND accept unauthenticated access.
# This is intentionally commented out — do not enable without understanding the risk.
# ARCHGUARD_DASHBOARD_ALLOW_REMOTE=

# --- Proxy / Reverse Proxy ---
# Comma-separated list of trusted proxy IP addresses for X-Forwarded-For resolution.
# Example: 10.0.0.1,10.0.0.2 for an internal load balancer.
# ARCHGUARD_TRUSTED_PROXY_IPS is used for BOTH auth and rate-limiting: the
# rate limiter reads the real client IP from X-Forwarded-For when the request
# arrives from a trusted proxy. Set to "*" only when the app is reachable
# solely through your platform's proxy (Railway, Render).
ARCHGUARD_TRUSTED_PROXY_IPS=

# ARCHGUARD_TRUSTED_PROXY_HOPS - Optional, default: 1
# How many trusted proxies sit between the client and this process. The client
# IP is read as the Nth X-Forwarded-For entry counting from the RIGHT, because
# a proxy only appends what it saw and never validates entries already in the
# header - so every entry further left is chosen by the caller. Set this to 2
# if you run a CDN in front of your platform proxy, and so on. Getting it too
# high is safe (several users share a bucket); too low is not.
# ARCHGUARD_TRUSTED_PROXY_HOPS=1


# ── Datastores (REQUIRED)  ───────────────────────────────────────
# ArchGuard stores users, jobs, runs and suppressions in PostgreSQL, and
# sessions, job progress and rate limits in Redis. There is no file-based
# fallback for either. `docker compose up -d postgres redis` starts both;
# see docs/DEVELOPMENT.md for setting them up without Docker.

# DATABASE_URL — REQUIRED. The +asyncpg driver is not optional: SQLAlchemy
# would otherwise pick a synchronous driver and deadlock the event loop.
# Platforms that inject a bare postgres:// URL are handled automatically.
DATABASE_URL=postgresql+asyncpg://archguard:CHANGE_ME@127.0.0.1:5432/archguard_dev

# TEST_DATABASE_URL — used only by the integration tests, which migrate this
# database up and tear it back down to base. Point it at a SEPARATE database:
# aiming it at your development one drops your data.
TEST_DATABASE_URL=postgresql+asyncpg://archguard:CHANGE_ME@127.0.0.1:5432/archguard_test

# REDIS_URL — REQUIRED.
REDIS_URL=redis://127.0.0.1:6379/0

# ARCHGUARD_DB_POOL_SIZE / ARCHGUARD_DB_MAX_OVERFLOW — Optional, 5 / 10.
# ARCHGUARD_DB_ECHO — Optional. Set to 1 to log every SQL statement.

# --- Deployment ---
# Set to 'production' in production deployments.
ENVIRONMENT=development

# ── CORS (Cross-Origin Resource Sharing)  ────────────────────────

# ALLOWED_ORIGINS — Optional
# Comma-separated list of allowed frontend origins.
# In production, set to your Vercel/Netlify/CDN domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ── Session & Rate Limiting  ─────────────────────────────────────

# ARCHGUARD_SESSION_COOKIE_TTL — Optional, default: 86400 (seconds = 24 hours)
# How long a browser login session (auth cookie) is valid after login.
# Increase for convenience; decrease for tighter security.
# ARCHGUARD_SESSION_COOKIE_TTL=86400

# How long in-memory AI Advisor conversation context is retained per session.
# This is SEPARATE from the login cookie TTL above.

# ── Analysis Performance  ────────────────────────────────────────

# ARCHGUARD_SKIP_ML — Optional, default: not set
# Set to "1" to skip ML-heavy Layer 3 semantic drift analysis (faster, less accurate).
# ARCHGUARD_SKIP_ML=1

# ARCHGUARD_SKIP_LLM — Optional, default: not set
# Set to "1" to skip all LLM calls (AI Advisor and fix suggestions).
# ARCHGUARD_SKIP_LLM=1

# ARCHGUARD_MOCK_LLM — Optional, default: not set (set to "1" in CI tests)
# Returns mock LLM responses instead of calling the real API. Used in tests.
# ARCHGUARD_MOCK_LLM=1

# ARCHGUARD_CLONE_TIMEOUT — Optional, default: 120 (seconds)
# Maximum time in seconds to wait for a git clone to complete.
# Increase for very large repositories.
ARCHGUARD_CLONE_TIMEOUT=120

# ARCHGUARD_ANALYSIS_TIMEOUT — Optional, default: 600 (seconds)
# Maximum time in seconds to wait for the analysis pipeline to complete.
# Increase for extremely large monorepos.
ARCHGUARD_ANALYSIS_TIMEOUT=600

# ── Disk limits  ──────────────────────────────────────────────────

# ARCHGUARD_MAX_REPO_SIZE_KB — Optional, default: 512000 (500 MB)
# Largest repository accepted for analysis, in kilobytes — the unit the GitHub
# API reports. Submissions above this are refused with HTTP 413 before anything
# is cloned. Set to 0 to disable the ceiling.
# ARCHGUARD_MAX_REPO_SIZE_KB=512000

# ARCHGUARD_MAX_WORKSPACE_BYTES — Optional, default: 5368709120 (5 GiB)
# Ceiling on the total bytes held by all analysis workspaces under the system
# temp directory. Checked before each clone; the oldest workspaces belonging to
# jobs that are no longer running are evicted until the total fits. A finished
# job's clone is only a cache — the dashboard falls back to the persisted run
# once it is gone. Set to 0 to disable the ceiling.
# ARCHGUARD_MAX_WORKSPACE_BYTES=5368709120

# ARCHGUARD_EMBEDDING_BATCH_SIZE — Optional, default: 500
# Number of code embeddings computed per batch (Layer 3).
# ARCHGUARD_EMBEDDING_BATCH_SIZE=500

# ── Audit Log  ────────────────────────────────────────────────────

# ARCHGUARD_AUDIT_MAX_SIZE_MB — Optional, default: 10
# Maximum size of the .archguard-cache/audit.jsonl file in megabytes.
# ARCHGUARD_AUDIT_MAX_SIZE_MB=10

# ARCHGUARD_AUDIT_MAX_ENTRIES — Optional, default: 1000
# Maximum number of entries in the audit log.
# ARCHGUARD_AUDIT_MAX_ENTRIES=1000

# ARCHGUARD_AUDIT_SECRET — Optional
# HMAC secret for audit log signature verification.
# ARCHGUARD_AUDIT_SECRET=your-audit-hmac-secret

# ARCHGUARD_AUDIT_STRICT — Optional, default: not set
# Set to "1" to enable strict audit mode (rejects tampered logs).
# ARCHGUARD_AUDIT_STRICT=1

# ARCHGUARD_LOCK_TIMEOUT — Optional, default: 30.0 (seconds)
# Timeout for cache locking operations.
# ARCHGUARD_LOCK_TIMEOUT=30.0

# ── Notifications  ────────────────────────────────────────────────

# ARCHGUARD_SLACK_WEBHOOK — Optional
# Slack Incoming Webhook URL for architectural regression alerts.
# Format: https://hooks.slack.com/services/T.../B.../...
# ARCHGUARD_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ── Deployment  ────────────────────────────────────────────────────

# ENVIRONMENT — Optional, used by /health endpoint
# ENVIRONMENT=production

# ── REVERSE PROXY CONFIGURATION  ──────────────────────────────────
# If running behind nginx, Caddy, or a cloud load balancer:
# The dashboard's auth check uses the client IP from the request.
# In a proxied setup, set this to the proxy's IP(s) so auth works
# correctly:
# This is now read by archguard/dashboard/_auth.py — setting it correctly is required for any deployment behind a reverse proxy or load balancer.
# ARCHGUARD_TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
# Without this, all requests will appear to come from the proxy IP
# (localhost)
# and may bypass the remote-access restriction.
