# ArchGuard environment variables. Copy to .env and fill in what you need —
# every variable below has a working default except where noted "(required)".
# ArchGuard does not auto-load .env files; export these in your shell or CI
# environment, or use a tool like direnv / python-dotenv in your own workflow.

## LLM explanation (Anthropic Claude) — optional; omit to skip LLM explanations
ANTHROPIC_API_KEY=
ARCHGUARD_PRIMARY_MODEL=claude-sonnet-4-20250514
ARCHGUARD_FALLBACK_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-20250514

## AI Advisor (dashboard advisor sessions) — OpenAI-backed, separate from the
## Anthropic key above; required only if you use the dashboard's Advisor panel
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

## Local-model support (implemented but not yet reachable from the CLI — see
## README FAQ "How do I use a local LLM instead of Claude?")
OLLAMA_MODEL=llama3

## Dashboard authentication
ARCHGUARD_DASHBOARD_TOKEN=
ARCHGUARD_DASHBOARD_ALLOW_REMOTE=
ARCHGUARD_SESSION_TTL=3600

## Audit log integrity
ARCHGUARD_AUDIT_SECRET=
ARCHGUARD_AUDIT_STRICT=
ARCHGUARD_AUDIT_MAX_ENTRIES=1000
ARCHGUARD_AUDIT_MAX_SIZE_MB=10

## Analysis pipeline tuning
ARCHGUARD_EMBEDDING_BATCH_SIZE=500
ARCHGUARD_LOCK_TIMEOUT=30.0
ARCHGUARD_SKIP_ML=
ARCHGUARD_SKIP_LLM=
ARCHGUARD_MOCK_LLM=

## Notifications
ARCHGUARD_SLACK_WEBHOOK=

## GitHub integration (PR comments, checks)
GITHUB_TOKEN=

## S3 cache sync (`archguard sync push/pull`)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
