# ────────────────────────────────────────────────────────────────
# ArchGuard Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────

# ── LLM / AI  ────────────────────────────────────────────────────

# ANTHROPIC_API_KEY — Optional (but recommended)
# Used by: archguard/llm/cloud.py, archguard/llm/advisor.py
# Without this: L4 LLM explanation layer is silently skipped.
#   With this: violations get AI-generated explanations.
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ARCHGUARD_PRIMARY_MODEL — Optional, default: claude-sonnet-4-20250514
# The primary Anthropic model used for L4 explanations.
# ARCHGUARD_PRIMARY_MODEL=claude-sonnet-4-20250514

# ARCHGUARD_FALLBACK_MODEL — Optional, default: claude-haiku-4-5-20251001
# Fallback model if the primary model fails.
# ARCHGUARD_FALLBACK_MODEL=claude-haiku-4-5-20251001

# OPENAI_API_KEY — Optional
# Used by: archguard/llm/openai_provider.py (Architecture Advisor feature)
# Without this: the /api/v1/advisor/analyze endpoint returns empty recommendations.
# OPENAI_API_KEY=sk-...your-key-here...

# OPENAI_MODEL — Optional, default: gpt-4-turbo
# OPENAI_MODEL=gpt-4-turbo

# OPENAI_BASE_URL — Optional, default: https://api.openai.com/v1
# Set this to use an OpenAI-compatible endpoint (e.g., Azure OpenAI, local LLM).
# OPENAI_BASE_URL=https://api.openai.com/v1

# OLLAMA_BASE_URL — Optional, default: http://localhost:11434
# Used when running local LLMs via Ollama.
# OLLAMA_BASE_URL=http://localhost:11434

# OLLAMA_MODEL — Optional, default: codellama
# OLLAMA_MODEL=codellama

# ── GitHub Integration  ──────────────────────────────────────────

# GITHUB_TOKEN — Optional but STRONGLY recommended for the GitHub URL feature
# Used by: archguard/github/client.py, archguard/cli/_analyze_github.py
# Without this: GitHub API limited to 60 requests/hour (unauthenticated).
#   With a personal access token (classic): 5000 requests/hour.
#   Minimum required scope: public_repo (for public repositories)
GITHUB_TOKEN=ghp_...your-token-here...

# ── Dashboard Security  ──────────────────────────────────────────

# ARCHGUARD_DASHBOARD_TOKEN — Optional
# When set, all dashboard API requests must include:
#   Authorization: Bearer <your-token>
# Without this: dashboard is accessible from localhost only (ARCHGUARD_DASHBOARD_ALLOW_REMOTE
#   must be set to 1 to allow remote access without authentication).
# ARCHGUARD_DASHBOARD_TOKEN=your-secret-dashboard-token

# ARCHGUARD_DASHBOARD_ALLOW_REMOTE — Optional, default: not set (remote access denied)
# Set to "1" or "true" to allow access from non-localhost without a token.
# WARNING: only use this in trusted network environments.
# ARCHGUARD_DASHBOARD_ALLOW_REMOTE=1

# ── CORS (Cross-Origin Resource Sharing)  ────────────────────────

# ALLOWED_ORIGINS — Optional
# Comma-separated list of allowed frontend origins.
# In production, set to your Vercel/Netlify/CDN domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ── Session & Rate Limiting  ─────────────────────────────────────

# ARCHGUARD_SESSION_TTL — Optional, default: 3600 (seconds)
# How long in-memory advisor sessions are retained.
# ARCHGUARD_SESSION_TTL=3600

# ── Analysis Performance  ────────────────────────────────────────

# ARCHGUARD_SKIP_ML — Optional, default: not set
# Set to "1" to skip ML-heavy Layer 3 semantic drift analysis (faster, less accurate).
# ARCHGUARD_SKIP_ML=1

# ARCHGUARD_SKIP_LLM — Optional, default: not set
# Set to "1" to skip all LLM calls (Layer 4 explanation and advisor).
# ARCHGUARD_SKIP_LLM=1

# ARCHGUARD_MOCK_LLM — Optional, default: not set (set to "1" in CI tests)
# Returns mock LLM responses instead of calling the real API. Used in tests.
# ARCHGUARD_MOCK_LLM=1

# ARCHGUARD_CLONE_TIMEOUT — Optional, default: 120 (seconds)
# Maximum time in seconds to wait for a git clone to complete.
# Increase for very large repositories.
ARCHGUARD_CLONE_TIMEOUT=120

# ARCHGUARD_EMBEDDING_BATCH_SIZE — Optional, default: 500
# Number of code embeddings computed per batch (Layer 3).
# ARCHGUARD_EMBEDDING_BATCH_SIZE=500

# ── Audit Log  ────────────────────────────────────────────────────

# ARCHGUARD_AUDIT_MAX_SIZE_MB — Optional, default: 10
# Maximum size of the .archguard-cache/audit.jsonl file in megabytes.
# ARCHGUARD_AUDIT_MAX_SIZE_MB=10

# ARCHGUARD_AUDIT_MAX_ENTRIES — Optional, default: 1000
# Maximum number of entries in the audit log.
# ARCHGUARD_AUDIT_MAX_ENTRIES=1000

# ARCHGUARD_AUDIT_SECRET — Optional
# HMAC secret for audit log signature verification.
# ARCHGUARD_AUDIT_SECRET=your-audit-hmac-secret

# ARCHGUARD_AUDIT_STRICT — Optional, default: not set
# Set to "1" to enable strict audit mode (rejects tampered logs).
# ARCHGUARD_AUDIT_STRICT=1

# ARCHGUARD_LOCK_TIMEOUT — Optional, default: 30.0 (seconds)
# Timeout for cache locking operations.
# ARCHGUARD_LOCK_TIMEOUT=30.0

# ── Notifications  ────────────────────────────────────────────────

# ARCHGUARD_SLACK_WEBHOOK — Optional
# Slack Incoming Webhook URL for violation notifications.
# Format: https://hooks.slack.com/services/T.../B.../...
# ARCHGUARD_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ── GitHub Actions (set automatically by GitHub, do not set manually)  ──
# GITHUB_REPOSITORY  — e.g. "owner/repo"
# GITHUB_EVENT_PATH  — path to the GitHub event JSON file
# GITHUB_ACTIONS     — set to "true" in GitHub Actions
# GITHUB_SHA         — the commit SHA being analyzed
# CI                 — set to "true" in most CI environments

# ── Deployment  ────────────────────────────────────────────────────

# ENVIRONMENT — Optional, used by /health endpoint
# ENVIRONMENT=production

# ── REVERSE PROXY CONFIGURATION  ──────────────────────────────────
# If running behind nginx, Caddy, or a cloud load balancer:
# The dashboard's auth check uses the client IP from the request.
# In a proxied setup, set this to the proxy's IP(s) so auth works
# correctly:
# ARCHGUARD_TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
# Without this, all requests will appear to come from the proxy IP
# (localhost)
# and may bypass the remote-access restriction.
